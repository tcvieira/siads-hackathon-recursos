{
  "$schema": "https://kiro.dev/schemas/permissions.json",
  "description": "Allowlist de ferramentas e comandos do agente para o projeto Solare (Hackathon AWS x MPF). Operacoes de leitura, edicao de arquivos, build, testes e git nao-destrutivo rodam sem aprovacao. Acoes destrutivas ou de alto impacto continuam exigindo confirmacao explicita.",
  "permissions": {
    "allow": [
      { "tool": "read_file", "comment": "Leitura de arquivos e sempre segura." },
      { "tool": "list_directory", "comment": "Listagem de diretorios e segura." },
      { "tool": "file_search", "comment": "Busca por nome de arquivo." },
      { "tool": "grep_search", "comment": "Busca de conteudo por regex." },
      { "tool": "read_code", "comment": "Analise de codigo via AST." },
      { "tool": "fs_write", "comment": "Criacao/escrita de arquivos dentro do workspace." },
      { "tool": "str_replace", "comment": "Edicao pontual de arquivos." },
      { "tool": "fs_append", "comment": "Append em arquivos existentes." },
      { "tool": "semantic_rename", "comment": "Rename de simbolos no codigo." },
      { "tool": "smart_relocate", "comment": "Mover arquivos atualizando imports." },
      { "tool": "create_artifact", "comment": "Geracao de artefatos para revisao." },
      { "tool": "todo_list", "comment": "Gestao da lista de tarefas." },
      { "tool": "update_session_information", "comment": "Atualizacao de status da sessao." },
      { "tool": "remote_web_search", "comment": "Pesquisa web para consultar docs/versoes." },
      { "tool": "web_fetch", "comment": "Leitura de paginas publicas de documentacao." },
      { "tool": "execute_pwsh", "command": "git status", "comment": "Inspecao do repositorio." },
      { "tool": "execute_pwsh", "command": "git diff *", "comment": "Ver diferencas." },
      { "tool": "execute_pwsh", "command": "git log *", "comment": "Historico de commits." },
      { "tool": "execute_pwsh", "command": "git branch *", "comment": "Listar/criar branches." },
      { "tool": "execute_pwsh", "command": "git checkout *", "comment": "Trocar/criar branch." },
      { "tool": "execute_pwsh", "command": "git switch *", "comment": "Trocar/criar branch." },
      { "tool": "execute_pwsh", "command": "git fetch *", "comment": "Buscar do remoto." },
      { "tool": "execute_pwsh", "command": "git pull *", "comment": "Atualizar branch local." },
      { "tool": "execute_pwsh", "command": "git add *", "comment": "Stage de arquivos." },
      { "tool": "execute_pwsh", "command": "git stash *", "comment": "Guardar alteracoes temporariamente." },
      { "tool": "execute_pwsh", "command": "git ls-remote *", "comment": "Inspecionar refs do remoto." },
      { "tool": "execute_pwsh", "command": "git commit *", "comment": "Commit local (sem push)." },
      { "tool": "execute_pwsh", "command": "npm install *", "comment": "Instalar dependencias do frontend." },
      { "tool": "execute_pwsh", "command": "npm run *", "comment": "Scripts de build/lint/test do frontend." },
      { "tool": "execute_pwsh", "command": "npm test *", "comment": "Testes do frontend." },
      { "tool": "execute_pwsh", "command": "npx *", "comment": "Execucao de ferramentas npm pontuais." },
      { "tool": "execute_pwsh", "command": "pip install *", "comment": "Instalar dependencias Python." },
      { "tool": "execute_pwsh", "command": "python -m *", "comment": "Rodar modulos Python (pytest, venv etc.)." },
      { "tool": "execute_pwsh", "command": "pytest *", "comment": "Testes do backend." },
      { "tool": "execute_pwsh", "command": "ruff *", "comment": "Lint Python." },
      { "tool": "execute_pwsh", "command": "sam build *", "comment": "Build da aplicacao SAM." },
      { "tool": "execute_pwsh", "command": "sam validate *", "comment": "Validacao do template SAM." },
      { "tool": "execute_pwsh", "command": "sam local *", "comment": "Execucao local do SAM (invoke, start-api)." }
    ],
    "ask": [
      { "tool": "execute_pwsh", "command": "git push *", "comment": "Push altera o remoto compartilhado: confirmar antes." },
      { "tool": "execute_pwsh", "command": "git reset --hard *", "comment": "Reset destrutivo: confirmar." },
      { "tool": "execute_pwsh", "command": "git clean *", "comment": "Remove arquivos nao rastreados: confirmar." },
      { "tool": "execute_pwsh", "command": "git rebase *", "comment": "Reescreve historico: confirmar." },
      { "tool": "execute_pwsh", "command": "git branch -D *", "comment": "Delecao forcada de branch: confirmar." },
      { "tool": "execute_pwsh", "command": "sam deploy *", "comment": "Deploy em ambiente AWS: alto impacto, confirmar." },
      { "tool": "execute_pwsh", "command": "sam delete *", "comment": "Remove stack na AWS: confirmar." },
      { "tool": "execute_pwsh", "command": "aws *", "comment": "Qualquer comando AWS CLI toca recursos de nuvem: confirmar." },
      { "tool": "execute_pwsh", "command": "cdk deploy *", "comment": "Deploy via CDK: confirmar." },
      { "tool": "execute_pwsh", "command": "cdk destroy *", "comment": "Destroi stack CDK: confirmar." },
      { "tool": "delete_file", "comment": "Delecao de arquivos sempre pede confirmacao." }
    ],
    "deny": [
      { "tool": "read_file", "path": "**/.env", "comment": "Nao ler segredos do .env." },
      { "tool": "read_file", "path": "**/.env.*", "comment": "Nao ler variantes de .env com segredos." },
      { "tool": "read_file", "path": "**/*.pem", "comment": "Nao ler chaves privadas." },
      { "tool": "read_file", "path": "**/credentials", "comment": "Nao ler arquivo de credenciais AWS." }
    ]
  }
}
