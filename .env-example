# Copie este arquivo para .env e preencha os valores.
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amplify (tarefa 1.1)
AMPLIFY_APP_ID=

# Cognito (gravados por scripts/cognito.sh; COGNITO_DOMAIN é só o prefixo)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# Outputs do stack SAM sisgares
API_URL=
TABLE_NAME=

# Frontend (o Vite só expõe ao navegador as variáveis com prefixo VITE_)
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_API_URL=
VITE_REDIRECT_URI=
